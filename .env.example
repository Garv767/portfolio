# ==============================================================================
# Environment Configuration Template (.env.local)
# Copy this file to .env.local and populate with your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Neon Serverless PostgreSQL Database
# ------------------------------------------------------------------------------
# Connection string from Neon Console (https://console.neon.tech)
DATABASE_URL="postgresql://username:password@ep-xyz.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require"
NEON_DATABASE_URL="postgresql://username:password@ep-xyz.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. Neon S3-Compatible Object Storage
# ------------------------------------------------------------------------------
# Credentials generated from Neon Storage settings or AWS S3
AWS_ENDPOINT_URL_S3="https://br-xyz.storage.c-6.us-east-2.aws.neon.tech"
AWS_REGION="us-east-2"
AWS_ACCESS_KEY_ID="your_neon_s3_access_key_id"
AWS_SECRET_ACCESS_KEY="your_neon_s3_secret_access_key"
NEON_S3_BUCKET_NAME="resume-storage"

# ------------------------------------------------------------------------------
# 3. Google Gemini AI Studio (AI Resume Studio)
# ------------------------------------------------------------------------------
# API Key from Google AI Studio (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY="your_gemini_api_key"

# ------------------------------------------------------------------------------
# 4. GitHub Synchronization (Optional for local development, required for CI/Actions)
# ------------------------------------------------------------------------------
# Personal access token with repo scope (to avoid GitHub API rate limits)
GITHUB_TOKEN=""

# ------------------------------------------------------------------------------
# 5. EmailJS (Contact form in development branch)
# ------------------------------------------------------------------------------
REACT_APP_EMAILJS_SERVICE_ID="your_emailjs_service_id"
REACT_APP_EMAILJS_TEMPLATE_ID="your_emailjs_template_id"
REACT_APP_EMAILJS_PUBLIC_KEY="your_emailjs_public_key"